@model MiniCRM.Models.Campanha
@{
    ViewData["Title"] = "Criar Campanha";
}

<div class="w3-container w3-card-4 w3-white w3-round-large" style="max-width: 650px; margin: 40px auto !important;">
    <h2 class="w3-text-teal w3-center" style="font-weight: bold; margin-top: 20px;">
        📢 Nova Campanha
    </h2>
    <p class="w3-center w3-text-grey">Planeje o próximo disparo ou publicação da marca.</p>
    <hr>

    <form asp-controller="Campanha" asp-action="Create" method="post" class="w3-container w3-padding-16">
        
        <div class="w3-row-padding" style="margin: 0 -16px;">
            <div class="w3-half">
                <label style="font-weight: bold;" class="w3-text-dark-grey">Título da Campanha</label>
                <input asp-for="Nome" class="w3-input w3-border w3-round w3-margin-bottom" type="text" placeholder="Ex: Promoção Dia das Mães" required>
            </div>
            <div class="w3-half">
                <label style="font-weight: bold;" class="w3-text-dark-grey">Cliente</label>
                <select asp-for="ClienteId" asp-items="ViewBag.Clientes" class="w3-select w3-border w3-round w3-margin-bottom" required>
                    <option value="">-- Selecione o Cliente --</option>
                </select>
            </div>
        </div>

        <div class="w3-row-padding" style="margin: 0 -16px;">
            <div class="w3-half">
                <label style="font-weight: bold;" class="w3-text-dark-grey">Orçamento (R$)</label>
                <input asp-for="Orcamento" class="w3-input w3-border w3-round w3-margin-bottom" type="number" step="0.01" min="0.01" placeholder="Ex: 500.00" required>
            </div>
            <div class="w3-half">
                <label style="font-weight: bold;" class="w3-text-dark-grey">Status Inicial</label>
                <select asp-for="Status" class="w3-select w3-border w3-round w3-margin-bottom">
                    <option value="Planejada">Planejada</option>
                </select>
            </div>
        </div>

        <div class="w3-row-padding" style="margin: 0 -16px;">
            <div class="w3-half">
                <label style="font-weight: bold;" class="w3-text-dark-grey">Data de Início</label>
                <input asp-for="DataInicio" class="w3-input w3-border w3-round w3-margin-bottom" type="date" required>
            </div>
            <div class="w3-half">
                <label style="font-weight: bold;" class="w3-text-dark-grey">Data de Fim</label>
                <input asp-for="DataFim" class="w3-input w3-border w3-round w3-margin-bottom" type="date" required>
            </div>
        </div>

        <div class="w3-row-padding w3-margin-top" style="margin: 0 -16px;">
            <div class="w3-half">
                <button type="submit" class="w3-button w3-block w3-teal w3-round w3-padding-large" style="font-weight: bold;">
                    <i class="fa fa-check"></i> Agendar Campanha
                </button>
            </div>
            <div class="w3-half">
                <a asp-controller="Campanha" asp-action="Index" class="w3-button w3-block w3-light-grey w3-border w3-round w3-padding-large w3-center" style="text-decoration: none;">Cancelar</a>
            </div>
        </div>
    </form>
</div>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <title>Login - Mini CRM</title>
</head>
@await Html.PartialAsync("_Alertas")
<body class="w3-light-grey">
    <div class="w3-container w3-round-xxlarge w3-display-middle w3-card-4 w3-white" style="width: 90%; max-width: 400px; padding: 24px;">
        <div class="w3-center">
            <h2 class="w3-text-blue" style="font-weight: bold; margin-bottom: 0;">Área de Login</h2>
            <p class="w3-text-grey" style="margin-top: 5px;">Mini-CRM de Vendas</p>
            <i class="fa fa-user-circle w3-text-blue w3-margin-top" style="font-size: 5.5em;"></i>
        </div>


        <form class="w3-container w3-margin-top" asp-controller="Login" asp-action="Login" method="post">
            <div class="w3-section">
                <label style="font-weight: bold;" class="w3-text-grey">E-mail do Usuário</label>
                <input class="w3-input w3-border w3-round-large w3-margin-bottom" type="email" name="usuario" placeholder="Digite seu e-mail" required>

                <label style="font-weight: bold;" class="w3-text-grey">Senha</label>
                <input class="w3-input w3-border w3-round-large" type="password" name="senha" placeholder="Digite sua senha" required>

                <!-- NOVO: Link para Esqueci a Senha -->
                <div class="w3-right-align w3-margin-top w3-margin-bottom">
                    <a asp-controller="Usuario" asp-action="RecuperarSenha" class="w3-text-blue w3-small" style="text-decoration: none; font-weight: bold;">Esqueci minha senha</a>
                </div>

                <button class="w3-button w3-block w3-blue w3-round-large w3-section w3-padding-large" type="submit" style="font-weight: bold;">
                    Entrar <i class="fa fa-sign-in"></i>
                </button>
            </div>
        </form>
        
        <div class="w3-center w3-margin-top">
            <span class="w3-text-grey">Não tem uma conta?</span>
            <a asp-controller="Usuario" asp-action="Create" class="w3-text-blue" style="text-decoration: none; font-weight: bold;">Cadastre-se</a>
        </div>
    </div>
</body>
</html>
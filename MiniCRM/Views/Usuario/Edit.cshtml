@model MiniCRM.Models.Usuario
@{
    ViewData["Title"] = "Editar Usuário";
}

<div class="w3-container w3-card-4 w3-white w3-margin w3-round-large w3-display-middle" style="width: 90%; max-width: 500px;">
    <h2 class="w3-text-blue w3-center" style="font-weight: bold; margin-top: 20px;">
        <i class="fa fa-edit"></i> Editar Perfil
    </h2>
    <hr>
    
    <form asp-action="Edit" method="post" class="w3-container w3-padding-16">
        <!-- Input oculto para vincular o ID na atualização -->
        <input type="hidden" asp-for="Id" />
        
        <label style="font-weight: bold;" class="w3-text-dark-grey">Nome Completo</label>
        <input asp-for="Nome" class="w3-input w3-border w3-round w3-margin-bottom" type="text" required>

        <label style="font-weight: bold;" class="w3-text-dark-grey">E-mail Corporativo</label>
        <input asp-for="Email" class="w3-input w3-border w3-round w3-margin-bottom" type="email" required>

        <label style="font-weight: bold;" class="w3-text-dark-grey">Telefone / WhatsApp</label>
        <input asp-for="Telefone" class="w3-input w3-border w3-round w3-margin-bottom" type="text" placeholder="(DD) 9XXXX-XXXX" required>

        <label style="font-weight: bold;" class="w3-text-dark-grey">Nova Senha <span class="w3-text-grey w3-small" style="font-weight: normal;">(Opcional)</span></label>
        <input asp-for="Senha" class="w3-input w3-border w3-round w3-margin-bottom" type="password" value="" placeholder="Preencha apenas se for alterar">

        <label style="font-weight: bold;" class="w3-text-dark-grey">Perfil de Acesso</label>
        <select asp-for="Perfil" class="w3-select w3-border w3-round w3-margin-bottom" required>
            <option value="Admin">Administrador</option>
            <option value="Vendedor">Vendedor</option>
            <option value="Atendimento">Atendimento</option>
        </select>

        <div class="w3-margin-bottom w3-margin-top w3-light-grey w3-padding w3-round w3-border">
            <input asp-for="Ativo" class="w3-check" type="checkbox">
            <label style="font-weight: bold; margin-left: 8px;" class="w3-text-dark-grey">Usuário Ativo no Sistema</label>
            <p class="w3-small w3-text-grey" style="margin-top: 5px; margin-left: 32px;">Desmarque para bloquear temporariamente o acesso deste operador.</p>
        </div>

        <button type="submit" class="w3-button w3-block w3-blue w3-round w3-margin-top w3-padding-large" style="font-weight: bold;">
            <i class="fa fa-refresh"></i> Atualizar Dados
        </button>
        <a asp-controller="Home" asp-action="Index" class="w3-button w3-block w3-light-grey w3-border w3-round w3-margin-top w3-center">Cancelar</a>
    </form>
</div>
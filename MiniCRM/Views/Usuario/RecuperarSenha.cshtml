@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <title>Recuperar Senha - Mini CRM</title>
</head>
<body class="w3-light-grey">
    <div class="w3-container w3-round-xxlarge w3-display-middle w3-card-4 w3-white" style="width: 90%; max-width: 400px; padding: 24px;">
        <div class="w3-center">
            <h2 class="w3-text-blue" style="font-weight: bold; margin-bottom: 0;">Esqueci a Senha</h2>
            <p class="w3-text-grey" style="margin-top: 5px;">Enviaremos uma nova senha para o seu WhatsApp</p>
            <i class="fa fa-whatsapp w3-text-green w3-margin-top" style="font-size: 5.5em;"></i>
        </div>

        <form class="w3-container w3-margin-top" asp-controller="Usuario" asp-action="RecuperarSenha" method="post">
            <div class="w3-section">
                <label style="font-weight: bold;" class="w3-text-grey">Seu E-mail Cadastrado</label>
                <!-- O name="email" deve ser igual ao parâmetro recebido no Controller -->
                <input class="w3-input w3-border w3-round-large w3-margin-bottom" type="email" name="email" placeholder="exemplo@crm.com" required>

                <button class="w3-button w3-block w3-green w3-round-large w3-section w3-padding-large" type="submit" style="font-weight: bold;">
                    Enviar Nova Senha <i class="fa fa-paper-plane"></i>
                </button>
            </div>
        </form>

        <div class="w3-center w3-margin-top">
            <a asp-controller="Login" asp-action="Login" class="w3-text-blue" style="text-decoration: none; font-weight: bold;">Voltar ao Login</a>
        </div>
    </div>
</body>
</html>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Painel";
}

<div class="w3-padding w3-text-grey w3-display-middle w3-center" style="width: 90%; max-width: 950px;">
    <h1 class="w3-center w3-blue w3-round-large w3-margin w3-padding" style="font-weight: bold;">
        🚀 CRM Marketing Hub
    </h1>
    
    <div class="w3-row-padding w3-margin-top" style="display: flex; flex-wrap: wrap; align-items: stretch;">
        
        <div class="w3-quarter w3-margin-bottom" style="display: flex;">
            <a asp-controller="Cliente" asp-action="Create" class="w3-button w3-blue w3-round-large w3-block" style="text-decoration: none; padding: 25px 0; white-space: normal; height: 100%; display: flex; flex-direction: column; justify-content: center;">
                <i class="fa fa-user-plus" style="font-size: 4.5em"></i>
                <p style="font-size: 1.4em; margin: 15px 0 0 0; line-height: 1.2; font-weight: bold;">Novo Cliente</p>
            </a>
        </div>

        <div class="w3-quarter w3-margin-bottom" style="display: flex;">
            <a asp-controller="Cliente" asp-action="Index" class="w3-button w3-blue w3-round-large w3-block" style="text-decoration: none; padding: 25px 0; white-space: normal; height: 100%; display: flex; flex-direction: column; justify-content: center;">
                <i class="fa fa-users" style="font-size: 4.5em"></i>
                <p style="font-size: 1.4em; margin: 15px 0 0 0; line-height: 1.2; font-weight: bold;">Ver Clientes</p>
            </a>
        </div>

        <div class="w3-quarter w3-margin-bottom" style="display: flex;">
            <a asp-controller="Campanha" asp-action="Create" class="w3-button w3-teal w3-round-large w3-block" style="text-decoration: none; padding: 25px 0; white-space: normal; height: 100%; display: flex; flex-direction: column; justify-content: center;">
                <i class="fa fa-bullhorn" style="font-size: 4.5em"></i>
                <p style="font-size: 1.4em; margin: 15px 0 0 0; line-height: 1.2; font-weight: bold;">Nova Campanha</p>
            </a>
        </div>

        <div class="w3-quarter w3-margin-bottom" style="display: flex;">
            <a asp-controller="Campanha" asp-action="Index" class="w3-button w3-teal w3-round-large w3-block" style="text-decoration: none; padding: 25px 0; white-space: normal; height: 100%; display: flex; flex-direction: column; justify-content: center;">
                <i class="fa fa-envelope-open" style="font-size: 4.5em"></i>
                <p style="font-size: 1.4em; margin: 15px 0 0 0; line-height: 1.2; font-weight: bold;">Ver Campanhas</p>
            </a>
        </div>

    </div>
</div>